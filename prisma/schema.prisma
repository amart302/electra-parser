generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(255)
  slug     String  @unique
  imageUrl String? @db.VarChar(2048)

  subcategories Subcategory[]
  products      Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("categories")
}

model Subcategory {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  slug     String
  imageUrl String? @db.VarChar(2048)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(500)
  sourceUrl String   @unique @db.VarChar(2048)
  imageUrls String[] @default([])

  price Decimal? @db.Decimal(12, 2)
  brand String?  @db.VarChar(255)

  heightMm       Decimal? @db.Decimal(10, 2)
  widthMm        Decimal? @db.Decimal(10, 2)
  lengthMm       Decimal? @db.Decimal(10, 2)
  diameterMm     Decimal? @db.Decimal(10, 2)
  baseDiameterMm Decimal? @db.Decimal(10, 2)

  lampCount        Int?
  maxLampPowerW    Decimal? @db.Decimal(12, 3)
  maxProductPowerW Decimal? @db.Decimal(12, 3)
  voltageV         Decimal? @db.Decimal(12, 3)
  lampBase         String?  @db.VarChar(100)

  lightingAreaM2 Decimal? @db.Decimal(12, 3)

  lightingMode       String?  @db.VarChar(100)
  maxConnectedUnits  Int?
  color              String?  @db.VarChar(255)
  wireColor          String?  @db.VarChar(255)
  moistureProtection String?  @db.VarChar(100)
  hasController      Boolean?
  powerConsumptionW  Decimal? @db.Decimal(12, 3)
  isFrostResistant   Boolean?

  lampshadeMaterial String? @db.VarChar(255)
  frameMaterial     String? @db.VarChar(255)
  frameColor        String? @db.VarChar(255)
  lampshadeColor    String? @db.VarChar(255)
  mountingMethod    String? @db.VarChar(255)
  diffuserShape     String? @db.VarChar(255)

  packaging          String?  @db.VarChar(255)
  packageHeightCm    Decimal? @db.Decimal(10, 2)
  packageWidthCm     Decimal? @db.Decimal(10, 2)
  packageLengthCm    Decimal? @db.Decimal(10, 2)
  packageWeightKg    Decimal? @db.Decimal(10, 3)
  packageVolumeM3    Decimal? @db.Decimal(12, 6)
  quantityPerPackage Int?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([subcategoryId])
  @@map("products")
}
