generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(255)
  slug     String  @unique
  imageUrl String? @db.VarChar(2048)

  subcategories Subcategory[]
  products      Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("categories")
}

model Subcategory {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  slug     String
  imageUrl String? @db.VarChar(2048)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(500)
  sourceUrl String   @unique @db.VarChar(2048)
  imageUrls String[] @default([])

  price Int?

  attributes ProductAttribute[]

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([subcategoryId])
  @@map("products")
}

model Attribute {
  id   Int           @id @default(autoincrement())
  key  String        @unique @db.VarChar(255)
  name String        @db.VarChar(255)
  type AttributeType @default(TEXT)
  unit String?       @db.VarChar(50)

  products ProductAttribute[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("attributes")
}

model ProductAttribute {
  productId   Int
  attributeId Int

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  textValue    String?
  numberValue  Decimal? @db.Decimal(20, 6)
  booleanValue Boolean?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([productId, attributeId])
  @@index([attributeId, numberValue])
  @@index([attributeId, booleanValue])
  @@map("product_attributes")
}
