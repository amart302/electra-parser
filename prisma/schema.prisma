generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(255)
  slug     String  @unique
  imageUrl String? @db.VarChar(2048)

  subcategories Subcategory[]
  products      Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("categories")
}

model Subcategory {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  slug     String
  imageUrl String? @db.VarChar(2048)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(500)
  sourceUrl String   @unique @db.VarChar(2048)
  imageUrls String[] @default([])

  price Int?
  brand String? @db.VarChar(255)

  dimensions ProductDimensions?
  electrical ProductElectrical?
  appearance ProductAppearance?
  packaging  ProductPackaging?
  attributes ProductAttribute[]

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([subcategoryId])
  @@map("products")
}

model ProductDimensions {
  productId Int     @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  heightMm               Decimal? @db.Decimal(10, 2)
  widthMm                Decimal? @db.Decimal(10, 2)
  lengthMm               Decimal? @db.Decimal(10, 2)
  diameterMm             Decimal? @db.Decimal(10, 2)
  baseDiameterMm         Decimal? @db.Decimal(10, 2)
  mountingHoleDiameterMm Decimal? @db.Decimal(10, 2)

  @@map("product_dimensions")
}

model ProductElectrical {
  productId Int     @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  voltageV          Decimal? @db.Decimal(12, 3)
  maxLampPowerW     Decimal? @db.Decimal(12, 3)
  maxProductPowerW  Decimal? @db.Decimal(12, 3)
  powerConsumptionW Decimal? @db.Decimal(12, 3)
  lampCount         Int?
  lampBase          String?  @db.VarChar(255)
  ipRating          String?  @db.VarChar(255)

  @@map("product_electrical")
}

model ProductAppearance {
  productId Int     @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  frameColor        String? @db.VarChar(255)
  lampshadeColor    String? @db.VarChar(255)
  baseColor         String? @db.VarChar(255)
  frameMaterial     String? @db.VarChar(255)
  lampshadeMaterial String? @db.VarChar(255)
  diffuserShape     String? @db.VarChar(255)
  mountingMethod    String? @db.VarChar(255)

  @@map("product_appearance")
}

model ProductPackaging {
  productId Int     @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  packaging          String?  @db.VarChar(255)
  quantityPerPackage Int?
  heightCm           Decimal? @db.Decimal(10, 2)
  widthCm            Decimal? @db.Decimal(10, 2)
  lengthCm           Decimal? @db.Decimal(10, 2)
  weightKg           Decimal? @db.Decimal(10, 3)
  volumeM3           Decimal? @db.Decimal(12, 6)

  @@map("product_packaging")
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
}

model Attribute {
  id       Int                @id @default(autoincrement())
  key      String             @unique @db.VarChar(255)
  name     String             @db.VarChar(255)
  type     AttributeType
  unit     String?            @db.VarChar(50)
  products ProductAttribute[]

  @@map("attributes")
}

model ProductAttribute {
  productId   Int
  attributeId Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  textValue    String?
  numberValue  Decimal? @db.Decimal(20, 6)
  booleanValue Boolean?

  @@id([productId, attributeId])
  @@index([attributeId, numberValue])
  @@index([attributeId, booleanValue])
  @@map("product_attributes")
}
